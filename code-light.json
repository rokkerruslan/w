  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "constant",
          "constant.language",
          "constant.character",
          "constant.character.escape",
          "constant.numeric",
          "constant.numeric.float",
          "constant.other.placeholder",
          "entity.name.function",
          "entity.name.method",
          "entity.name",
				  "meta.export.default",
				  "meta.definition.variable",
          "support.function",
          "storage",
          "entity.name.constant",
				  "variable.other.constant",
				  "storage.type",
          "support.function.builtin",
          "meta.function-call",
          "entity.name.type",
          "entity.name.struct",
          "support.type",
          "support.class",
          "variable.parameter",
          "meta.function.parameters variable.parameter",
          "punctuation.section.parens",
          "punctuation.section.brackets",
          "variable.parameter.function",
          "variable",
          "variable.other",
          "variable.other.readwrite",
				  "meta.jsx.children",
				  "meta.block",
				  "meta.tag.attributes",
				  "entity.name.constant",
				  "meta.object.member",
				  "meta.embedded.expression",
          "punctuation.section.braces"
        ],
        "settings": {
          "foreground": "#808891"
        }
      },
      {
        "scope": [
          "keyword"
        ],
        "settings": {
          "foreground": "#6e7277"
        }
      },
      {
        "scope": [
          "string",
        ],
        "settings": {
          "foreground": "#7b8289"
        }
      },
      {
        "scope": [
          "comment",
          "punctuation.definition.comment",
          "string.comment"
        ],
        "settings": {
          "foreground": "#5c5c5c"
        }
      }
    ]
  }
}
